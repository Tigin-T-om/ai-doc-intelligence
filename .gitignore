.DS_Store
Thumbs.db

# Logs and outputs
*.log
*.out
*.bak

# PDF parsing temp files (optional, if created)
*.pdf_cache/
tmp/

# FAISS / Chroma index folders (if persisted)
index/
faiss_index/
chroma_db/
